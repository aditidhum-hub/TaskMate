# TaskMate Frontend Client Configuration
# Target backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Firebase Client Web SDK Configuration (Safe for client-side inclusion)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyExamplePlaceholderKey
VITE_FIREBASE_AUTH_DOMAIN=taskmate-example.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=taskmate-example
VITE_FIREBASE_STORAGE_BUCKET=taskmate-example.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
