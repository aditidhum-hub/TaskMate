# TaskMate Backend Environment Configuration

# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# LLM Provider Configuration (Nemotron runtime agent - Phase 6)
LLM_PROVIDER=nemotron
LLM_MODEL=nvidia/nemotron-4-340b-instruct
LLM_API_KEY=your_nemotron_api_key_here
NVIDIA_API_KEY=your_nemotron_api_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Firebase Configuration (Authentication & Cloud Firestore - Phase 2 & 3)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"
